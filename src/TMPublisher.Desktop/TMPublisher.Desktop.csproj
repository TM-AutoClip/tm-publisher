<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia desktop app: views, view models, tray, autostart, single instance, first-run wizard, composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TMPublisher</AssemblyName>
    <RootNamespace>TMPublisher.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <!--
    Memory: the app runs in the tray all day. Workstation GC (one heap) without the background GC thread. Measured for 0.1.2 (managed heap
    is only 4-7 MB): System.GC.ConserveMemory=5 and TieredPGO=false changed nothing measurable and are not set.
  -->
  <PropertyGroup>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
    <ProjectReference Include="..\TMPublisher.Platforms\TMPublisher.Platforms.csproj" />
    <ProjectReference Include="..\TMPublisher.Storage\TMPublisher.Storage.csproj" />
    <ProjectReference Include="..\TMPublisher.Scheduling\TMPublisher.Scheduling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Language files are embedded (WithCulture=false: the .en/.tr suffix is not a satellite culture). -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="TMPublisher.Lang.%(Filename)%(Extension)" WithCulture="false" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\app.ico;Assets\app-256.png" />
    <!-- Font licenses travel inside the program (OFL: the license must accompany the font); the Linux archive also has them as files. -->
    <AvaloniaResource Include="Assets\Licenses\*.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
