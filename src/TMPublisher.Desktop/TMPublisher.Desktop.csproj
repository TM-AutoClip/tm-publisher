<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia desktop app: views, view models, tray, autostart, single instance, first-run wizard, composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TMPublisher</AssemblyName>
    <RootNamespace>TMPublisher.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
    <ProjectReference Include="..\TMPublisher.Platforms\TMPublisher.Platforms.csproj" />
    <ProjectReference Include="..\TMPublisher.Storage\TMPublisher.Storage.csproj" />
    <ProjectReference Include="..\TMPublisher.Scheduling\TMPublisher.Scheduling.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Language files are embedded (WithCulture=false: the .en/.tr suffix is not a satellite culture). -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="TMPublisher.Lang.%(Filename)%(Extension)" WithCulture="false" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\app.ico;Assets\app-256.png" />
    <None Include="Assets\Licenses\*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="licenses" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
