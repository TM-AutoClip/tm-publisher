<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Avalonia window program: views, view models, autostart, single instance, first-run wizard, composition root, and the short-lived
    notification process ("notify" mode). It runs only while the user has the window open; the background scheduler (TMPublisher.Background)
    sends the posts.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TMPublisher</AssemblyName>
    <RootNamespace>TMPublisher.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Memory: workstation GC (one heap) without the background GC thread (measured for 0.1.2: the managed heap is only 4-7 MB). -->
  <PropertyGroup>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <!--
    Published trimmed (only the code that is used; compiled bindings, no reflection-based XAML): the exe is about 45 MB instead of 107 MB and
    uses less memory. Trimming warnings are errors like every warning; every page was opened in a trimmed build for 0.1.3.
  -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
    <ProjectReference Include="..\TMPublisher.Platforms\TMPublisher.Platforms.csproj" />
    <ProjectReference Include="..\TMPublisher.Storage\TMPublisher.Storage.csproj" />
    <ProjectReference Include="..\TMPublisher.Scheduling\TMPublisher.Scheduling.csproj" />
    <ProjectReference Include="..\TMPublisher.Runtime\TMPublisher.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\app.ico;Assets\app-256.png" />
    <!-- Font licenses travel inside the program (OFL: the license must accompany the font); the Linux archive also has them as files. -->
    <AvaloniaResource Include="Assets\Licenses\*.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
