<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:n="using:TMPublisher.Desktop.Notifications"
        x:Class="TMPublisher.Desktop.Views.ToastWindow"
        x:DataType="n:ToastViewModel"
        Title="TM Publisher"
        WindowDecorations="None"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Background="{DynamicResource tm-surface}">
  <Border BorderBrush="{DynamicResource tm-border-strong}" BorderThickness="1">
    <Grid ColumnDefinitions="4,Auto,*,Auto">
      <Border Background="{DynamicResource tm-success}" />
      <Border Background="{DynamicResource tm-warning}" IsVisible="{Binding IsAttention}" />
      <Border Background="{DynamicResource tm-danger}" IsVisible="{Binding IsError}" />
      <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontSize="18" Margin="12,12,0,12" VerticalAlignment="Top" />
      <StackPanel Grid.Column="2" Margin="10,12" Spacing="4">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="3" Name="CloseButton" Content="✕" Background="Transparent" VerticalAlignment="Top" Margin="4" />
    </Grid>
  </Border>
</Window>
