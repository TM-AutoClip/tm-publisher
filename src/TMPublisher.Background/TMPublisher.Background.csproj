<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The background scheduler: a small process without any UI library that waits for the next post's time and sends it. It is what starts
    with the computer; the window (TMPublisher.Desktop) runs only while the user has it open. Published as native code (Native AOT): no
    JIT, no IL kept in memory, a few MB at idle. Windows: a tray icon with raw Win32 calls. Linux: no tray (the menu entry opens the window).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TMPublisherScheduler</AssemblyName>
    <RootNamespace>TMPublisher.Background</RootNamespace>
    <ApplicationIcon>..\TMPublisher.Desktop\Assets\app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <!--
      Texts are formatted with the invariant culture (only names and numbers are put into them); no ICU library is loaded. The window
      stores post texts NFC-normalized, so the X length check (which normalizes) counts the same here, where normalization is not available.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
    <ProjectReference Include="..\TMPublisher.Platforms\TMPublisher.Platforms.csproj" />
    <ProjectReference Include="..\TMPublisher.Storage\TMPublisher.Storage.csproj" />
    <ProjectReference Include="..\TMPublisher.Scheduling\TMPublisher.Scheduling.csproj" />
    <ProjectReference Include="..\TMPublisher.Runtime\TMPublisher.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
