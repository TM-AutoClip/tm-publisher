<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sending without a window, as a library of the one program file: the run the system scheduler starts (the program with its run-due option: open the
    database, send what is due, set the next start, end), the system scheduler itself (Windows Task Scheduler, systemd user timer, XDG
    autostart as the fallback), the lock that lets only one sender work per data folder, the clean-up of 0.1.0-0.1.4 autostart entries, and
    the services both the window and the run use to send. No UI library: a run loads no Avalonia assembly.
  -->
  <PropertyGroup>
    <RootNamespace>TMPublisher.Background</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
    <ProjectReference Include="..\TMPublisher.Platforms\TMPublisher.Platforms.csproj" />
    <ProjectReference Include="..\TMPublisher.Storage\TMPublisher.Storage.csproj" />
    <ProjectReference Include="..\TMPublisher.Scheduling\TMPublisher.Scheduling.csproj" />
    <ProjectReference Include="..\TMPublisher.Runtime\TMPublisher.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
