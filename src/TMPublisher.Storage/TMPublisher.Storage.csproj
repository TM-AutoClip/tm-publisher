<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Encrypted SQLite (SQLite3 Multiple Ciphers) through EF Core (no SQL written by hand), key protectors, backup format. Depends on Core only.
    0.1.0-0.1.2 used EF Core, 0.1.3-0.1.5 wrote the same tables with hand-written SQL, now EF Core again: the file format did not change.
  -->
  <PropertyGroup>
    <!--
      The program is published trimmed (one JIT program file since 0.1.5, nothing is compiled to native code): trimming warnings are errors
      here too. Not marked AOT compatible: EF Core needs dynamic code (it is not compatible with Native AOT without a compiled model).
    -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
