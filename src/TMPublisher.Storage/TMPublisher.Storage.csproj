<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Encrypted SQLite (SQLite3 Multiple Ciphers) with plain SQL, key protectors, backup format. Depends on Core only. No EF Core since 0.1.3:
    the background scheduler is compiled to native code, where an ORM model costs memory and needs reflection.
  -->
  <PropertyGroup>
    <!-- Also compiled into the native background scheduler: trimming / AOT warnings are errors here too. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
