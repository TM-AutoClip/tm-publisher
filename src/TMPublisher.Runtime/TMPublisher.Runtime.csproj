<Project Sdk="Microsoft.NET.Sdk">
  <!--
    What every mode of the program needs (window, the run the system scheduler starts, notifications): the data folder, the log files, the
    language files, the instance locks, and the "quit" request to a 0.1.3-0.1.4 scheduler after an update. No UI library. Depends on Core only.
    Safe for trimming.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TMPublisher.Core\TMPublisher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Language files are embedded (WithCulture=false: the .en/.tr suffix is not a satellite culture). -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="TMPublisher.Lang.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TMPublisher.Tests" />
  </ItemGroup>
</Project>
