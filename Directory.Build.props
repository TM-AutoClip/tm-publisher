<Project>
  <!--
    Shared build settings of every project.
    Version and product name live here only; the app reads them from the assembly attributes.
    Warnings are errors: a warning is fixed, never silenced (generated code excluded).
  -->
  <PropertyGroup>
    <Version>0.1.5</Version>
    <Product>TM Publisher</Product>
    <Company>TM AutoClip contributors</Company>
    <Copyright>Copyright (c) 2026 TM AutoClip contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <!-- Package vulnerability audit (transitive packages too); a known vulnerability stops the build. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Repository rules analyzer: one top-level type per file (TMP0001) and file name = type name (TMP0002), error level.
    Attached to every C# project except the analyzer itself.
  -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And '$(MSBuildProjectName)' != 'TMPublisher.Analyzers'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)dev/TMPublisher.Analyzers/TMPublisher.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
